@@ -62,0 +63,33 @@ public class HandTutorialNextGate : MonoBehaviour
+    public int CompletedObjectiveCount => _doneObjectives.Count;
+    public int RequiredObjectiveCount => _objectives.Count;
+    public bool WaitingForNarration => _completePending && !_completed;
+    public bool NextUnlocked => _nextButton!=null && _nextButton.activeInHierarchy;
+    public bool ResearchCalibrationHeld {get;private set;}
+    public void SetResearchCalibrationHold(bool held){ResearchCalibrationHeld=held;if(_nextButton!=null)_nextButton.SetActive(!held&&_completed);}
+    private bool _operatorStartRequired;
+    private bool _operatorStartAccepted;
+    public bool AwaitingOperatorStart {get;private set;}
+    public bool NarrationStarted {get;private set;}
+    // Separate from gaze accuracy/validation. Only the observer's explicit Start releases this wait.
+    public void RequireOperatorStart()
+    {
+        if(NarrationStarted||_operatorStartAccepted)return;
+        _operatorStartRequired=true;AwaitingOperatorStart=true;
+        if(_nextButton!=null)_nextButton.SetActive(false);
+    }
+    public bool StartTutorialNarration()
+    {
+        if(!isActiveAndEnabled||!AwaitingOperatorStart)return false;
+        AwaitingOperatorStart=false;_operatorStartAccepted=true;
+        NeonResearch.StudyEvents.Record("tutorial_start_requested","grabbing_tutorial","operator_start","Manual preparation finished or skipped; not a calibration approval.");
+        return true;
+    }
+    public string RemainingObjectives
+    {
+        get{var labels=new List<string>();for(int i=0;i<_objectives.Count;i++)if(!_doneObjectives.Contains(i))labels.Add(_objectives[i]?.label??"Missing objective configuration");return string.Join(", ",labels);}
+    }
+    public void ObserveActualGrab(Grabbable source,PointerEvent evt)
+    {
+        if(!isActiveAndEnabled||source==null||evt.Type!=PointerEventType.Select)return;
+        if(_grabbableToObjective.TryGetValue(source,out int objective))OnPointerEvent(objective,evt);
+    }
